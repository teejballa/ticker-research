# Vercel upload excludes. Everything here is either regenerated remotely during
# `next build`, installed remotely (`npm install`), or is local-only tooling /
# planning that the build & runtime never read. Without this file the CLI tars
# up .next/ (thousands of cache files → ~400MB, 18k+ files) and uploads flake.
#
# Do NOT add src/, public/, prisma/, scripts/, tests/, data/, or any config
# here — the remote build compiles/lints those.

# Build output — regenerated by `next build` on Vercel
.next/

# Installed remotely
node_modules/

# VCS + local agent tooling (the .claude worktree alone is ~3GB)
.git/
.claude/
.playwright-mcp/
.firecrawl/

# Planning & docs — never imported by build or runtime
.planning/
docs/

# Test / report artifacts
test-results/
playwright-report/
playwright/.cache/
coverage/

# Stray local screenshots at repo root
*.png
